From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Fri, 25 Sep 2026 20:23:39 +0100
Subject: dma-buf: system_heap: add a system-uncached heap (+ dma_heap_get_dev)

Re-add the dma-buf "system-uncached" heap that mainline dropped (~5.13). The
Rockchip libmali userspace and its WSI layer allocate write-combine/uncached
buffers from /dev/dma_heap/system-uncached; without it they fall back to cached
system memory, which corrupts on the non-coherent Mali GPU.

This is the Rockchip vendor mechanism (Simon Xue, commits a2ded8cab4d6 /
43fb28d9a879 / 1a44a281070e) adapted to mainline 7.x:
 - dma-heap: store the per-heap struct device and add dma_heap_get_dev(), which
   the uncached path needs for the one-time alloc-time cache flush.
 - system_heap: add an "uncached" priv flag alongside the existing cc_shared
   one (DMA_ATTR_SKIP_CPU_SYNC on map/unmap, pgprot_writecombine for mmap/vmap,
   skip the begin/end_cpu_access syncs, flush the freshly-zeroed pages once at
   allocation), and register the "system-uncached" heap.

The vendor's begin/end_cpu_access_partial ops and the kernel-space
dma_heap_find/dma_heap_buffer_alloc helpers are intentionally NOT ported: the
libmali userspace uses neither (only the standard full DMA_BUF_IOCTL_SYNC).

Carried by mali-dkms (Rockchip Mali-Valhall DKMS). Not for upstream.

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 drivers/dma-buf/dma-heap.c          | 16 ++
 drivers/dma-buf/heaps/system_heap.c | 77 ++++++++--
 include/linux/dma-heap.h            |  2 +
 3 files changed, 86 insertions(+), 9 deletions(-)

diff --git a/drivers/dma-buf/dma-heap.c b/drivers/dma-buf/dma-heap.c
index 43c32fb28313..f3187dd296ef 100644
--- a/drivers/dma-buf/dma-heap.c
+++ b/drivers/dma-buf/dma-heap.c
@@ -37,10 +37,11 @@
 struct dma_heap {
 	const char *name;
 	const struct dma_heap_ops *ops;
 	void *priv;
 	dev_t heap_devt;
+	struct device *heap_dev;
 	struct list_head list;
 	struct cdev heap_cdev;
 };
 
 static LIST_HEAD(heap_list);
@@ -222,10 +223,24 @@ const char *dma_heap_get_name(struct dma_heap *heap)
 {
 	return heap->name;
 }
 EXPORT_SYMBOL_NS_GPL(dma_heap_get_name, "DMA_BUF_HEAP");
 
+/**
+ * dma_heap_get_dev - get the struct device backing a heap
+ * @heap: DMA-Heap to retrieve the device of
+ *
+ * Returns:
+ * The struct device created for this heap (used e.g. for cache
+ * maintenance on the heap's own buffers).
+ */
+struct device *dma_heap_get_dev(struct dma_heap *heap)
+{
+	return heap->heap_dev;
+}
+EXPORT_SYMBOL_NS_GPL(dma_heap_get_dev, "DMA_BUF_HEAP");
+
 /**
  * dma_heap_add - adds a heap to dmabuf heaps
  * @exp_info: information needed to register this heap
  */
 struct dma_heap *dma_heap_add(const struct dma_heap_export_info *exp_info)
@@ -281,10 +296,11 @@ struct dma_heap *dma_heap_add(const struct dma_heap_export_info *exp_info)
 	if (IS_ERR(dev_ret)) {
 		pr_err("dma_heap: Unable to create device\n");
 		err_ret = ERR_CAST(dev_ret);
 		goto err2;
 	}
+	heap->heap_dev = dev_ret;
 
 	mutex_lock(&heap_list_lock);
 	/* check the name is unique */
 	list_for_each_entry(h, &heap_list, list) {
 		if (!strcmp(h->name, exp_info->name)) {
diff --git a/drivers/dma-buf/heaps/system_heap.c b/drivers/dma-buf/heaps/system_heap.c
index c8959eadc71d..489f3bb889d9 100644
--- a/drivers/dma-buf/heaps/system_heap.c
+++ b/drivers/dma-buf/heaps/system_heap.c
@@ -25,10 +25,11 @@
 #include <linux/slab.h>
 #include <linux/vmalloc.h>
 
 struct system_heap_priv {
 	bool cc_shared;
+	bool uncached;
 };
 
 struct system_heap_buffer {
 	struct dma_heap *heap;
 	struct list_head attachments;
@@ -36,18 +37,20 @@ struct system_heap_buffer {
 	unsigned long len;
 	struct sg_table sg_table;
 	int vmap_cnt;
 	void *vaddr;
 	bool cc_shared;
+	bool uncached;
 };
 
 struct dma_heap_attachment {
 	struct device *dev;
 	struct sg_table table;
 	struct list_head list;
 	bool mapped;
 	bool cc_shared;
+	bool uncached;
 };
 
 #define cc_shared_buffer(b) (IS_ENABLED(CONFIG_DMABUF_HEAPS_SYSTEM_CC_SHARED) && \
 				(b)->cc_shared)
 
@@ -130,10 +133,11 @@ static int system_heap_attach(struct dma_buf *dmabuf,
 
 	a->dev = attachment->dev;
 	INIT_LIST_HEAD(&a->list);
 	a->mapped = false;
 	a->cc_shared = buffer->cc_shared;
+	a->uncached = buffer->uncached;
 
 	attachment->priv = a;
 
 	mutex_lock(&buffer->lock);
 	list_add(&a->list, &buffer->attachments);
@@ -163,10 +167,12 @@ static struct sg_table *system_heap_map_dma_buf(struct dma_buf_attachment *attac
 	struct sg_table *table = &a->table;
 	unsigned long attrs;
 	int ret;
 
 	attrs = cc_shared_buffer(a) ? DMA_ATTR_CC_SHARED : 0;
+	if (a->uncached)
+		attrs |= DMA_ATTR_SKIP_CPU_SYNC;
 	ret = dma_map_sgtable(attachment->dev, table, direction, attrs);
 	if (ret)
 		return ERR_PTR(ret);
 
 	a->mapped = true;
@@ -176,13 +182,14 @@ static struct sg_table *system_heap_map_dma_buf(struct dma_buf_attachment *attac
 static void system_heap_unmap_dma_buf(struct dma_buf_attachment *attachment,
 				      struct sg_table *table,
 				      enum dma_data_direction direction)
 {
 	struct dma_heap_attachment *a = attachment->priv;
+	unsigned long attrs = a->uncached ? DMA_ATTR_SKIP_CPU_SYNC : 0;
 
 	a->mapped = false;
-	dma_unmap_sgtable(attachment->dev, table, direction, 0);
+	dma_unmap_sgtable(attachment->dev, table, direction, attrs);
 }
 
 static int system_heap_dma_buf_begin_cpu_access(struct dma_buf *dmabuf,
 						enum dma_data_direction direction)
 {
@@ -192,14 +199,16 @@ static int system_heap_dma_buf_begin_cpu_access(struct dma_buf *dmabuf,
 	mutex_lock(&buffer->lock);
 
 	if (buffer->vmap_cnt)
 		invalidate_kernel_vmap_range(buffer->vaddr, buffer->len);
 
-	list_for_each_entry(a, &buffer->attachments, list) {
-		if (!a->mapped)
-			continue;
-		dma_sync_sgtable_for_cpu(a->dev, &a->table, direction);
+	if (!buffer->uncached) {
+		list_for_each_entry(a, &buffer->attachments, list) {
+			if (!a->mapped)
+				continue;
+			dma_sync_sgtable_for_cpu(a->dev, &a->table, direction);
+		}
 	}
 	mutex_unlock(&buffer->lock);
 
 	return 0;
 }
@@ -213,14 +222,16 @@ static int system_heap_dma_buf_end_cpu_access(struct dma_buf *dmabuf,
 	mutex_lock(&buffer->lock);
 
 	if (buffer->vmap_cnt)
 		flush_kernel_vmap_range(buffer->vaddr, buffer->len);
 
-	list_for_each_entry(a, &buffer->attachments, list) {
-		if (!a->mapped)
-			continue;
-		dma_sync_sgtable_for_device(a->dev, &a->table, direction);
+	if (!buffer->uncached) {
+		list_for_each_entry(a, &buffer->attachments, list) {
+			if (!a->mapped)
+				continue;
+			dma_sync_sgtable_for_device(a->dev, &a->table, direction);
+		}
 	}
 	mutex_unlock(&buffer->lock);
 
 	return 0;
 }
@@ -236,10 +247,12 @@ static int system_heap_mmap(struct dma_buf *dmabuf, struct vm_area_struct *vma)
 	int i, ret;
 
 	prot = vma->vm_page_prot;
 	if (cc_shared_buffer(buffer))
 		prot = pgprot_decrypted(prot);
+	if (buffer->uncached)
+		prot = pgprot_writecombine(prot);
 
 	for_each_sgtable_sg(table, sg, i) {
 		unsigned long n = sg->length >> PAGE_SHIFT;
 
 		if (pgoff < n)
@@ -285,10 +298,12 @@ static void *system_heap_do_vmap(struct system_heap_buffer *buffer)
 	}
 
 	prot = PAGE_KERNEL;
 	if (cc_shared_buffer(buffer))
 		prot = pgprot_decrypted(prot);
+	if (buffer->uncached)
+		prot = pgprot_writecombine(prot);
 	vaddr = vmap(pages, npages, VM_MAP, prot);
 	vfree(pages);
 
 	if (!vaddr)
 		return ERR_PTR(-ENOMEM);
@@ -407,10 +422,11 @@ static struct dma_buf *system_heap_allocate(struct dma_heap *heap,
 	DEFINE_DMA_BUF_EXPORT_INFO(exp_info);
 	unsigned long size_remaining = len;
 	unsigned int max_order = orders[0];
 	struct system_heap_priv *priv = dma_heap_get_drvdata(heap);
 	bool cc_shared = priv->cc_shared;
+	bool uncached = priv->uncached;
 	struct dma_buf *dmabuf;
 	struct sg_table *table;
 	struct scatterlist *sg;
 	struct list_head pages;
 	struct page *page, *tmp_page;
@@ -423,10 +439,11 @@ static struct dma_buf *system_heap_allocate(struct dma_heap *heap,
 	INIT_LIST_HEAD(&buffer->attachments);
 	mutex_init(&buffer->lock);
 	buffer->heap = heap;
 	buffer->len = len;
 	buffer->cc_shared = cc_shared;
+	buffer->uncached = uncached;
 
 	INIT_LIST_HEAD(&pages);
 	i = 0;
 	while (size_remaining > 0) {
 		/*
@@ -476,10 +493,22 @@ static struct dma_buf *system_heap_allocate(struct dma_heap *heap,
 	dmabuf = dma_buf_export(&exp_info);
 	if (IS_ERR(dmabuf)) {
 		ret = PTR_ERR(dmabuf);
 		goto free_pages;
 	}
+
+	/*
+	 * For uncached buffers, flush the CPU cache once now: the __GFP_ZERO
+	 * pages were zeroed by the CPU and are likely cached, so map (which
+	 * implicitly flushes) and immediately unmap on the heap's own device to
+	 * avoid stale cache lines corrupting later uncached access.
+	 */
+	if (uncached) {
+		dma_map_sgtable(dma_heap_get_dev(heap), table, DMA_BIDIRECTIONAL, 0);
+		dma_unmap_sgtable(dma_heap_get_dev(heap), table, DMA_BIDIRECTIONAL, 0);
+	}
+
 	return dmabuf;
 
 free_pages:
 	for_each_sgtable_sg(table, sg, i) {
 		struct page *p = sg_page(sg);
@@ -512,23 +541,53 @@ static struct system_heap_priv system_heap_priv = {
 
 static struct system_heap_priv system_heap_cc_shared_priv = {
 	.cc_shared = true,
 };
 
+static struct system_heap_priv system_heap_uncached_priv = {
+	.cc_shared = false,
+	.uncached = true,
+};
+
+/* Used until system_heap_create() sets the heap device's DMA mask. */
+static struct dma_buf *system_uncached_heap_not_initialized(struct dma_heap *heap,
+							    unsigned long len,
+							    u32 fd_flags,
+							    u64 heap_flags)
+{
+	return ERR_PTR(-EBUSY);
+}
+
+static struct dma_heap_ops system_uncached_heap_ops = {
+	/* swapped to system_heap_allocate() once the dma mask is set */
+	.allocate = system_uncached_heap_not_initialized,
+};
+
 static int __init system_heap_create(void)
 {
 	struct dma_heap_export_info exp_info;
 	struct dma_heap *sys_heap;
+	struct dma_heap *sys_uncached_heap;
 
 	exp_info.name = "system";
 	exp_info.ops = &system_heap_ops;
 	exp_info.priv = &system_heap_priv;
 
 	sys_heap = dma_heap_add(&exp_info);
 	if (IS_ERR(sys_heap))
 		return PTR_ERR(sys_heap);
 
+	exp_info.name = "system-uncached";
+	exp_info.ops = &system_uncached_heap_ops;
+	exp_info.priv = &system_heap_uncached_priv;
+	sys_uncached_heap = dma_heap_add(&exp_info);
+	if (IS_ERR(sys_uncached_heap))
+		return PTR_ERR(sys_uncached_heap);
+	dma_coerce_mask_and_coherent(dma_heap_get_dev(sys_uncached_heap), DMA_BIT_MASK(64));
+	mb(); /* publish the dma mask before accepting allocations */
+	system_uncached_heap_ops.allocate = system_heap_allocate;
+
 	if (IS_ENABLED(CONFIG_HIGHMEM) ||
 	    !IS_ENABLED(CONFIG_DMABUF_HEAPS_SYSTEM_CC_SHARED) ||
 	    !cc_platform_has(CC_ATTR_MEM_ENCRYPT))
 		return 0;
 
